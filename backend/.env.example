# ==============================================================================
# COURT EVIDENCE MANAGEMENT SYSTEM (CEMS)
# Environment Configuration Template (.env.example)
#
# Duplicate this file to .env and fill in your actual environment values.
# NEVER commit your real .env file to Git or public repositories.
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security Keys (REQUIRED in Production: Use strong 64+ char random strings)
SECRET_KEY=replace-with-a-very-strong-random-secret-key-in-production
JWT_SECRET_KEY=replace-with-a-very-strong-random-jwt-key-64bytes-in-production
JWT_EXPIRATION_HOURS=24

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=cems_db

# CORS Allowed Origins
# Development: http://localhost:5500,http://127.0.0.1:5500
# Production: https://your-cems-frontend.netlify.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# File Uploads (Max 100MB in bytes)
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=uploads
